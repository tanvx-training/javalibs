         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Bill of Materials (BOM) for javalibs.

    Deliberately has NO parent: importing this BOM must only pin javalibs artifacts
    and never leak Spring Boot / third-party version management into client projects.

    Usage in a microservice:

      <dependencyManagement>
        <dependencies>
          <dependency>
            <groupId>io.javalibs</groupId>
            <artifactId>javalibs-dependencies</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <type>pom</type>
            <scope>import</scope>
          </dependency>
        </dependencies>
      </dependencyManagement>
  -->

  <groupId>io.javalibs</groupId>
  <artifactId>javalibs-dependencies</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>javalibs :: dependencies (BOM)</name>
  <description>Bill of Materials pinning the versions of every javalibs artifact</description>

