  </distributionManagement>

  <properties>
    <javalibs.distribution.releases.url>https://nexus.example.com/repository/maven-releases</javalibs.distribution.releases.url>
    <javalibs.distribution.snapshots.url>https://nexus.example.com/repository/maven-snapshots</javalibs.distribution.snapshots.url>
